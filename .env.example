# =============================================================================
# coding-pack Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY (required)
# Your Anthropic API key, used by Claude Code to authenticate API requests.
# Obtain one at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# GITHUB_TOKEN (optional)
# A GitHub personal access token used for automated PR creation via the
# GitHub API. Required only when using the PR-creation workflow.
# Scopes needed: repo (for private repos) or public_repo (for public repos).
# Generate one at: https://github.com/settings/tokens
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=your_github_token_here

# -----------------------------------------------------------------------------
# PULSE_API_PORT (optional, default: 8080)
# The port on which the Pulse API server listens. Override this if 8080 is
# already in use on your machine.
# -----------------------------------------------------------------------------
# PULSE_API_PORT=8080
